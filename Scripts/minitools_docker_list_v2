#!/usr/bin/bash
#writen by dberistain

#Defining some colors =========================
red="$(tput setaf 196 2>/dev/null || true)";
yellow="$(tput setaf 226 2>/dev/null || true)";
blue="$(tput setaf 69 2>/dev/null || true)";
green="$(tput setaf 118 2>/dev/null || true)";
gray="$(tput setaf 237 2>/dev/null || true)";
bold="$(tput bold 2>/dev/null || true)";
r="$(tput sgr0 2>/dev/null || true)";
blink="$(tput blink 2>/dev/null || true)";
#Defining some colors [END] ===================

#Defining bar spacers parameters ==============
masterWidth="210";
bbar=$(printf '%0.s—' $(seq 1 "$masterWidth"));
pbbar=$(printf '%0.s_' $(seq 1 "$masterWidth"));
#Defining bar spacers parameters [END] ========

center() {
    local text="$*"
    local textLength=${#text}
    local padding=$(( (masterWidth - textLength) / 2 ))
    [ "$padding" -lt 0 ] && padding=0
    echo; echo "$blue$bbar$r"
    printf '%*s%s\n' "$padding" '' "$bold$text$r"
    echo "$blue$bbar$r"
}

#Dependencies checker
if command -v minitools_dependencies_checker >/dev/null 2>&1; then
    dependencies="docker"
    minitools_dependencies_checker $dependencies
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "${red}Docker is not installed.${r}"
    exit 1
fi

if ! docker info >/dev/null 2>&1; then
    echo "${red}Docker is installed, but the Docker daemon is not reachable.${r}"
    exit 1
fi

trim_text() {
    local value="$1"
    local max="$2"
    if [ "${#value}" -gt "$max" ]; then
        printf '%s…' "${value:0:$((max-1))}"
    else
        printf '%s' "$value"
    fi
}

human_bytes() {
    local bytes="$1"
    if [ -z "$bytes" ] || [ "$bytes" = "0" ]; then
        echo "unlimited"
    elif command -v numfmt >/dev/null 2>&1; then
        numfmt --to=iec --suffix=B "$bytes" 2>/dev/null || echo "$bytes"
    else
        awk -v b="$bytes" 'BEGIN {printf "%.1fGB", b/1073741824}'
    fi
}

activeContainers=$(docker ps -a -q)
containerCount=$(docker ps -a -q | wc -l | xargs)
runningCount=$(docker ps -q | wc -l | xargs)

center "Docker Container Report"
echo "${bold}Docker version :${r} $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo N/A)"
echo "${bold}Containers     :${r} $containerCount total | ${green}$runningCount running${r}"
echo

echo "$blue$bbar$r"
printf ' %-3s | %-27s | %-31s | %-12s | %-12s | %-19s | %-10s | %-15s | %-15s | %-25s | %-14s | %-7s\n' \
    "#" "Container Name" "Container Base Image" "ID" "Restart" "Last Start" "Status" "Network" "IP Address" "Ports" "RAM Used/Limit" "CPU"
echo "$blue$bbar$r"

containerNum=0
if [ -z "$activeContainers" ]; then
    echo "No Docker containers were found."
else
    while read -r container; do
        [ -z "$container" ] && continue
        containerNum=$((containerNum + 1))

        containerName=$(docker inspect --format '{{.Name}}' "$container" 2>/dev/null | sed 's#^/##')
        containerImage=$(docker inspect --format '{{.Config.Image}}' "$container" 2>/dev/null)
        restartPolicy=$(docker inspect --format '{{.HostConfig.RestartPolicy.Name}}' "$container" 2>/dev/null)
        containerStatus=$(docker inspect --format '{{.State.Status}}' "$container" 2>/dev/null)
        startedAt=$(docker inspect --format '{{.State.StartedAt}}' "$container" 2>/dev/null)
        memoryLimit=$(docker inspect --format '{{.HostConfig.Memory}}' "$container" 2>/dev/null)

        if [[ "$startedAt" == 0001-* ]] || [ -z "$startedAt" ]; then
            startDisplay="Never"
        else
            startDisplay=$(date -d "$startedAt" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$startedAt")
        fi

        networks=$(docker inspect --format '{{range $name, $net := .NetworkSettings.Networks}}{{$name}} {{end}}' "$container" 2>/dev/null | xargs)
        ips=$(docker inspect --format '{{range $name, $net := .NetworkSettings.Networks}}{{$net.IPAddress}} {{end}}' "$container" 2>/dev/null | xargs)
        [ -z "$networks" ] && networks="-"
        [ -z "$ips" ] && ips="-"

        ports=$(docker port "$container" 2>/dev/null | awk '{print $1"->"$3}' | paste -sd',' -)
        [ -z "$ports" ] && ports="-"

        if [ "$containerStatus" = "running" ]; then
            statLine=$(docker stats --no-stream --format '{{.MemUsage}}|{{.CPUPerc}}' "$container" 2>/dev/null | head -n1)
            ramUsed=$(printf '%s' "$statLine" | cut -d'|' -f1 | cut -d'/' -f1 | xargs)
            cpuUsed=$(printf '%s' "$statLine" | cut -d'|' -f2 | xargs)
            [ -z "$ramUsed" ] && ramUsed="N/A"
            [ -z "$cpuUsed" ] && cpuUsed="N/A"
            statusDisplay="${green}${containerStatus}${r}"
        else
            ramUsed="-"
            cpuUsed="-"
            statusDisplay="${yellow}${containerStatus}${r}"
        fi

        limitDisplay=$(human_bytes "$memoryLimit")
        ramDisplay="$ramUsed/$limitDisplay"

        printf ' %-3s | %-27s | %-31s | %-12s | %-12s | %-19s | %-10b | %-15s | %-15s | %-25s | %-14s | %-7s\n' \
            "$containerNum" \
            "$(trim_text "$containerName" 27)" \
            "$(trim_text "$containerImage" 31)" \
            "${container:0:12}" \
            "$(trim_text "$restartPolicy" 12)" \
            "$(trim_text "$startDisplay" 19)" \
            "$statusDisplay" \
            "$(trim_text "$networks" 15)" \
            "$(trim_text "$ips" 15)" \
            "$(trim_text "$ports" 25)" \
            "$(trim_text "$ramDisplay" 14)" \
            "$cpuUsed"
    done <<< "$activeContainers"
fi

echo "$blue$bbar$r"
echo
