#!/usr/bin/bash
#writen by dberistain

smb_config="/etc/samba/smb.conf"

red="$(tput setaf 196 2>/dev/null || true)";
yellow="$(tput setaf 226 2>/dev/null || true)";
blue="$(tput setaf 69 2>/dev/null || true)";
green="$(tput setaf 118 2>/dev/null || true)";
gray="$(tput setaf 237 2>/dev/null || true)";
bold="$(tput bold 2>/dev/null || true)";
r="$(tput sgr0 2>/dev/null || true)";
blink="$(tput blink 2>/dev/null || true)";

masterWidth="148";
bbar=$(printf '%0.s—' $(seq 1 $masterWidth));
pbbar=$(printf '%0.s_' $(seq 1 $masterWidth));

center() {
    width=$masterWidth
    echo
    echo "$blue$bbar$r"
    for i
    do
        iCount="${#i}"
        if [ $((iCount%2)) -eq 0 ]; then fill=""; else fill=" "; fi
        padding=$(( ( width - iCount - 2) / 2 ))
        if [ "$padding" -lt 0 ]; then padding=0; fi
        if [ "$padding" -gt 0 ]; then padding=$(printf '%0.s ' $(seq 1 "$padding")); else padding=""; fi
        echo "$padding" "$bold$i$r" "$padding""$fill"
    done
    echo "$blue$bbar$r"
}

require_root() {
    if [ "$EUID" -ne 0 ]; then
        echo
        echo "${red}${bold}ERROR: This command must be run as root.${r}"
        echo "${green}Run: sudo $0${r}"
        echo
        exit 1
    fi
}

check_dependencies() {
    if command -v minitools_dependencies_checker >/dev/null 2>&1; then
        minitools_dependencies_checker "$@"
    else
        local missing=0 dep
        for dep in "$@"; do
            if ! command -v "$dep" >/dev/null 2>&1; then
                echo "${red}Missing dependency: $dep${r}"
                missing=$((missing+1))
            fi
        done
        [ "$missing" -eq 0 ] || exit 1
    fi
}

reload_samba() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl reload smbd >/dev/null 2>&1 && return 0
        systemctl reload samba >/dev/null 2>&1 && return 0
    fi
    if command -v service >/dev/null 2>&1; then
        service smbd reload >/dev/null 2>&1 && return 0
    fi
    return 1
}

share_names() {
    testparm -s "$smb_config" 2>/dev/null |
    awk '/^\[[^]]+\]/ {
        name=$0
        gsub(/^[[:space:]]*\[/, "", name)
        gsub(/\][[:space:]]*$/, "", name)
        low=tolower(name)
        if (low!="global" && low!="homes" && low!="printers" && low!="print$") print name
    }'
}

share_param() {
    local share="$1"
    local parameter="$2"
    testparm -s --section-name="$share" --parameter-name="$parameter" "$smb_config" 2>/dev/null | tail -n 1
}

yes_answer() {
    case "${1,,}" in
        y|yes|s|si|sí) return 0 ;;
        *) return 1 ;;
    esac
}

locate_share_file() {
    local wanted="$1" f
    while IFS= read -r -d '' f; do
        if awk -v s="$wanted" '
            function trim(x){gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); return x}
            { if (tolower(trim($0)) == tolower("[" s "]")) {found=1; exit} }
            END {exit !found}
        ' "$f" 2>/dev/null; then
            echo "$f"; return 0
        fi
    done < <(find /etc/samba -maxdepth 4 -type f \( -name 'smb.conf' -o -name '*.conf' -o -name '*.inc' \) ! -name '*.bak' ! -name '*.old' -print0 2>/dev/null)
    return 1
}

set_share_parameter() {
    local file="$1" share="$2" key="$3" value="$4" tmp
    tmp="$(mktemp)"
    awk -v share="$share" -v key="$key" -v value="$value" '
    function trim(x){gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); return x}
    function is_section(x){return x ~ /^\[[^]]+\]$/}
    BEGIN {inside=0; done=0}
    {
        t=trim($0)
        if (is_section(t)) {
            if (inside && !done) {print "    " key " = " value; done=1}
            inside=(tolower(t)==tolower("[" share "]"))
        }
        if (inside) {
            eq=index($0,"=")
            if (eq>0) {
                left=trim(substr($0,1,eq-1))
                if (tolower(left)==tolower(key)) {print "    " key " = " value; done=1; next}
            }
        }
        print
    }
    END {if (inside && !done) print "    " key " = " value}
    ' "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
    cat "$tmp" > "$file"; rm -f "$tmp"
}

user_used_elsewhere() {
    local username="$1" skip_share="$2" s values token
    while IFS= read -r s; do
        [ "$s" = "$skip_share" ] && continue
        values="$(share_param "$s" "valid users")"; values="${values//,/ }"
        for token in $values; do [ "$token" = "$username" ] && return 0; done
    done < <(share_names)
    return 1
}

clear -x
require_root
check_dependencies testparm smbpasswd pdbedit find awk
[ -f "$smb_config" ] || exit 1
mapfile -t shares < <(share_names)
center "REMOVE SAMBA SHARE"
[ "${#shares[@]}" -gt 0 ] || { echo " No Samba shares found."; center; exit 0; }
for i in "${!shares[@]}"; do path="$(share_param "${shares[$i]}" "path")"; printf " %3d) %-32s %s\n" "$((i+1))" "${shares[$i]}" "$path"; done
read -r -p "Select share number or exact share name: " selection
if [[ "$selection" =~ ^[0-9]+$ ]] && [ "$selection" -ge 1 ] && [ "$selection" -le "${#shares[@]}" ]; then share="${shares[$((selection-1))]}"; else share="$selection"; fi
found=no; for s in "${shares[@]}"; do [ "$s" = "$share" ] && found=yes; done; [ "$found" = yes ] || { echo "${red}Share not found.${r}"; exit 1; }
path="$(share_param "$share" "path")"; guest="$(share_param "$share" "guest ok")"; valid_users="$(share_param "$share" "valid users")"; timemachine="$(share_param "$share" "fruit:time machine")"
echo "$blue$bbar$r"; printf " %-20s %s\n" "Share:" "$share"; printf " %-20s %s\n" "Path:" "$path"; printf " %-20s %s\n" "Guest access:" "${guest:-No}"; printf " %-20s %s\n" "Authorized users:" "${valid_users:-N/A}"; printf " %-20s %s\n" "Time Machine:" "${timemachine:-No}"; echo "$blue$bbar$r"
echo "${yellow}The directory and its data will NOT be deleted.${r}"
read -r -p "Remove this Samba share definition? [y/N]: " answer; yes_answer "$answer" || exit 0
source_file="$(locate_share_file "$share")"; [ -n "$source_file" ] || { echo "${red}Could not locate config file defining [$share].${r}"; exit 1; }
backup="${source_file}.minitools_backup_$(date +%Y%m%d_%H%M%S).bak"; cp -a "$source_file" "$backup" || exit 1
tmp="$(mktemp)"
awk -v share="$share" '
function trim(x){gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); return x}
{
 t=trim($0)
 if (!skip && t == "# BEGIN MINITOOLS SHARE: " share) {skip=1; marked=1; next}
 if (!skip && tolower(t)==tolower("[" share "]")) {skip=1; marked=0; next}
 if (skip) {
   if (marked && t == "# END MINITOOLS SHARE: " share) {skip=0; marked=0; next}
   if (!marked && t ~ /^\[[^]]+\]$/) {skip=0; print $0}
   next
 }
 print
}' "$source_file" > "$tmp" || { rm -f "$tmp"; exit 1; }
cat "$tmp" > "$source_file"; rm -f "$tmp"
if ! testparm -s "$smb_config" >/dev/null 2>&1; then cp -a "$backup" "$source_file"; echo "${red}Validation failed; original restored.${r}"; exit 1; fi
reload_samba || echo "${yellow}Share removed; config valid, but automatic Samba reload failed.${r}"

explicit_users=(); vals="${valid_users//,/ }"; for user in $vals; do [[ "$user" == @* || "$user" == +* || "$user" == \&* || "$user" == *%* ]] || explicit_users+=("$user"); done
if [ "${#explicit_users[@]}" -gt 0 ]; then
    read -r -p "Review users from this share for deletion? [y/N]: " answer
    if yes_answer "$answer"; then
        for user in "${explicit_users[@]}"; do
            echo "$blue$pbbar$r"; echo "${bold}User: $user${r}"
            if user_used_elsewhere "$user" "$share"; then
                echo "${yellow}User is still authorized on another Samba share. Account will be kept.${r}"
                continue
            fi
            if pdbedit -L 2>/dev/null | cut -d: -f1 | grep -Fxq "$user"; then read -r -p "Delete Samba account '$user'? [y/N]: " a; yes_answer "$a" && smbpasswd -x "$user"; fi
            if getent passwd "$user" >/dev/null 2>&1; then read -r -p "Also delete Linux account '$user'? Home/data are NOT removed. [y/N]: " a; yes_answer "$a" && userdel "$user"; fi
        done
    fi
fi
center "SAMBA SHARE REMOVED"; printf " %-22s %s\n" "Removed share:" "$share"; printf " %-22s %s\n" "Data preserved at:" "$path"; printf " %-22s %s\n" "Config backup:" "$backup"; center; echo
